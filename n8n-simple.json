{
  "name": "AI Daily 新聞測試版",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "id": "schedule-001",
      "name": "每天8點"
    },
    {
      "parameters": {
        "url": "https://github-trending-api.now.sh/",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "id": "github-001",
      "name": "抓GitHub"
    },
    {
      "parameters": {
        "jsCode": "// 簡單處理 GitHub Trending\nconst data = $input.first().json;\nconst repos = Array.isArray(data) ? data : (data.repos || []);\n\nconst news = repos.slice(0, 8).map(r => ({\n  title: r.name || '無標題',\n  summary: r.description || '無描述',\n  url: r.html_url || '#',\n  source: 'GitHub',\n  score: Math.min(Math.floor((r.stars || 0) / 100), 10)\n}));\n\nreturn [{json: {news}}];"
      },
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "id": "process-001",
      "name": "處理數據"
    },
    {
      "parameters": {
        "command": "echo 'test' > /tmp/test.txt"
      },
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "id": "cmd-001",
      "name": "測試命令"
    }
  ],
  "connections": {
    "每天8點": {
      "main": [
        [
          {
            "node": "抓GitHub",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "抓GitHub": {
      "main": [
        [
          {
            "node": "處理數據",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "處理數據": {
      "main": [
        [
          {
            "node": "測試命令",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}